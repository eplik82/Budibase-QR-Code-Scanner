{
  "type": "component",
  "metadata": {
    "svelteMajor": 5
  },
  "schema": {
    "name": "QR-Code-Scanner",
    "friendlyName": "QR Code Scanner",
    "description": "A component that scans QR codes, including inverted (white on black) codes.",
    "icon": "Text",
    "settings": [
      {
        "type": "field/string",
        "key": "field",
        "label": "Field"
      },
      {
        "type": "text",
        "key": "label",
        "label": "Label",
        "defaultValue": "QR Code Scanner"
      },
      {
        "type": "event",
        "key": "onScan",
        "label": "On Scan",
        "context": [
          {
            "label": "Scanned Value",
            "key": "value"
          }
        ]
      },
      {
        "type": "select",
        "key": "inversionMode",
        "label": "Code Colors",
        "options": [
          { "label": "Dark on light and light on dark", "value": "attemptBoth" },
          { "label": "Dark on light only", "value": "dontInvert" },
          { "label": "Light on dark first", "value": "invertFirst" }
        ],
        "defaultValue": "attemptBoth"
      },
      {
        "type": "boolean",
        "key": "autoStartCamera",
        "label": "Auto Start Camera",
        "defaultValue": false
      },
      {
        "type": "boolean",
        "key": "continuousScan",
        "label": "Continuous Scanning",
        "defaultValue": false
      },
      {
        "type": "number",
        "key": "scanDelay",
        "label": "Same Code Rescan Delay (ms)",
        "min": 0,
        "max": 60000,
        "dependsOn": "continuousScan",
        "defaultValue": 1500
      },
      {
        "type": "boolean",
        "key": "showResult",
        "label": "Show Scanned Result",
        "defaultValue": true
      },
      {
        "type": "number",
        "key": "fps",
        "label": "FPS",
        "min": 1,
        "max": 60,
        "defaultValue": 15
      },
      {
        "type": "select",
        "key": "preferredCamera",
        "label": "Preferred Camera",
        "options": [
          { "label": "Back", "value": "back" },
          { "label": "Front", "value": "front" }
        ],
        "defaultValue": "back"
      },
      {
        "type": "select",
        "key": "resolution",
        "label": "Camera Resolution",
        "options": [
          { "label": "Standard (640x480)", "value": "sd" },
          { "label": "HD (1280x720)", "value": "hd" },
          { "label": "Full HD (1920x1080)", "value": "fullhd" }
        ],
        "defaultValue": "hd"
      },
      {
        "type": "number",
        "key": "zoom",
        "label": "Zoom Level",
        "min": 1,
        "max": 8,
        "defaultValue": 1
      },
      {
        "type": "boolean",
        "key": "showZoomControl",
        "label": "Show Zoom Slider",
        "defaultValue": true
      },
      {
        "type": "boolean",
        "key": "showTorchButton",
        "label": "Show Flashlight Button",
        "defaultValue": true
      },
      {
        "type": "boolean",
        "key": "soundOnScan",
        "label": "Play Sound On Scan",
        "defaultValue": true
      },
      {
        "type": "select",
        "key": "soundType",
        "label": "Sound",
        "options": [
          { "label": "Beep", "value": "beep" },
          { "label": "Double beep", "value": "double" },
          { "label": "Chime", "value": "chime" }
        ],
        "dependsOn": "soundOnScan",
        "defaultValue": "beep"
      },
      {
        "type": "number",
        "key": "soundVolume",
        "label": "Sound Volume (0-100)",
        "min": 0,
        "max": 100,
        "dependsOn": "soundOnScan",
        "defaultValue": 50
      },
      {
        "type": "boolean",
        "key": "vibrateOnScan",
        "label": "Vibrate On Scan",
        "defaultValue": false
      },
      {
        "type": "boolean",
        "key": "allowFileScan",
        "label": "Allow Scanning From Image File",
        "defaultValue": true
      },
      {
        "type": "boolean",
        "key": "scannerBox",
        "label": "Use Scanner Box",
        "defaultValue": false
      },
      {
        "type": "number",
        "key": "scannerBoxWidth",
        "label": "Scanner Box Width",
        "min": 1,
        "max": 10000,
        "dependsOn": "scannerBox",
        "defaultValue": 250
      },
      {
        "type": "number",
        "key": "scannerBoxHeight",
        "label": "Scanner Box Height",
        "min": 1,
        "max": 10000,
        "dependsOn": "scannerBox",
        "defaultValue": 250
      },
      {
        "type": "number",
        "key": "maxVideoHeight",
        "label": "Max Camera Height (% of screen)",
        "min": 10,
        "max": 100,
        "defaultValue": 60
      }
    ]
  }
}
